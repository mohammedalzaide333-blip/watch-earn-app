# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل

PORT=3000

# مفتاح سري لتوقيع تسجيل الدخول (JWT) - غيّره لقيمة عشوائية طويلة
JWT_SECRET=change-this-to-a-long-random-secret

# رابط الاتصال بقاعدة بيانات PostgreSQL
# احصل عليه مجانًا من Neon (neon.tech) أو Supabase (supabase.com)
# شكله يشبه: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/watchearn

# إعدادات الأرباح
RATE_PER_VIEW=0.004
AD_DURATION_SECONDS=12
MIN_WITHDRAW=5

# الحد الأقصى لعدد المشاهدات المسموحة لكل مستخدم في الساعة (لمنع الغش)
MAX_VIEWS_PER_HOUR=30

# ===== إعدادات شبكة الإعلانات الحقيقية (Offerwall) =====
# اتركها فارغة إن لم تكن قد اشتركت بعد بأي شبكة — الموقع سيعمل بوضع "محاكاة" تلقائيًا

# رابط الـ Offerwall الذي تحصل عليه من لوحة تحكم الشبكة (AdGate/OfferToro/إلخ)
# ضع {USER_ID} في مكان معرّف المستخدم كما تطلبه الشبكة (subid عادة)
# مثال: https://theoffervault.com/wall?pub_id=12345&subid={USER_ID}
OFFERWALL_URL_TEMPLATE=

# مفتاح سري من عندك (اخترعه أنت)، تضعه أيضًا كـ "secret" ثابت في رابط الـ Postback
# الذي تسجّله في لوحة تحكم الشبكة الإعلانية — يمنع أي شخص من تزوير طلبات إضافة رصيد
OFFERWALL_SECRET=
